# Copy to .env.production. npm run deploy reads that file.
# Leave APP_URL, SHORT_URL_BASE, DATABASE_URL, SESSION_SECRET,
# ENCRYPTION_KEY, and DEPLOY_HEALTHCHECK_URL empty to generate them.
# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=production
APP_NAME=Sharry
# Public hostname. Deploy uses https://DOMAIN for the URLs below when they are empty.
DOMAIN=share.example.com
APP_URL=
APP_HOST=0.0.0.0
APP_PORT=3000

# ==========================================
# PUBLIC SHORT URLS
# ==========================================
SHORT_URL_BASE=
SHORT_URL_PREFIX=/s

# ==========================================
# DATABASE
# Leave empty on the first deploy. The script creates the role and writes the URL here.
# ==========================================
DATABASE_URL=

# ==========================================
# INITIAL ADMINISTRATOR
# Used only the first time the database is empty
# ==========================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# ==========================================
# AUTHENTICATION
# Leave the secret and the key empty to generate them on the first deploy.
# Keep ENCRYPTION_KEY. Replacing it makes saved two-factor secrets unreadable.
# ==========================================
SESSION_SECRET=
ENCRYPTION_KEY=
OTP_ISSUER=Sharry

# ==========================================
# VPS DEPLOYMENT
# Local deployment machine only. Never copied to the server.
# DEPLOY_USER is root, or a user that can run sudo -n.
# ==========================================
DEPLOY_ENABLED=false
DEPLOY_HOST=123.0.123.12
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_SSH_KEY_PATH=/absolute/path/to/private_key
DEPLOY_REMOTE_DIR=/var/www/sharry
DEPLOY_BUILD_COMMAND=npm run build
DEPLOY_RESTART_SERVICE=sharry
DEPLOY_HEALTHCHECK_URL=
DEPLOY_KNOWN_HOSTS_PATH=

# ==========================================
# OPTIONAL
# ==========================================
REDIS_URL=
GEOIP_DB_PATH=
QR_DATA_DIR=data/qr-logos
AVATAR_DATA_DIR=data/avatars
