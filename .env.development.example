# Copy to .env.development. Local commands read that file.
# npm run dev, npm run db:migrate, npm run setup, npm run create-admin, npm run backup
# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
# Shown in the sidebar, browser title, and sign-in page.
# Blank or omitted stays Sharry. The slug of this name prefixes API keys,
# cookies, CSV exports, backups, and the domain TXT record.
# "My Brand" becomes my-brand_session and my-brand_...
APP_NAME=Sharry
APP_URL=http://127.0.0.1:5173
APP_HOST=127.0.0.1
APP_PORT=3000

# ==========================================
# PUBLIC SHORT URLS
# ==========================================
SHORT_URL_BASE=http://127.0.0.1:3000
SHORT_URL_PREFIX=/s

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://sharry:sharry@127.0.0.1:54330/sharry

# ==========================================
# INITIAL ADMINISTRATOR
# Used only the first time the database is empty
# ==========================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-local-admin

# ==========================================
# AUTHENTICATION
# Each value must be at least 32 characters.
# ==========================================
SESSION_SECRET=change-me-local-session-secret-32chars
ENCRYPTION_KEY=change-me-local-encryption-key-32ch
OTP_ISSUER=Sharry

# ==========================================
# OPTIONAL
# ==========================================
REDIS_URL=
GEOIP_DB_PATH=
QR_DATA_DIR=data/qr-logos
AVATAR_DATA_DIR=data/avatars
