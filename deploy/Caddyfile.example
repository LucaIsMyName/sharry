# Replace the site address, then install this file for Caddy.
# Caddy terminates HTTPS and proxies every request to Sharry.
# Verified redirect domains receive a certificate through on-demand TLS.
{
	on_demand_tls {
		ask http://127.0.0.1:3000/internal/caddy/ask
	}
}

share.example.com {
	reverse_proxy 127.0.0.1:3000
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3000
}
